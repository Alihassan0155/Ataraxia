{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Ataraxia semantic metadata v2: observed references separate from verification",
  "type": "object",
  "additionalProperties": false,
  "required": ["primary_category", "subcategory", "secondary_categories", "topics", "tags", "video_format", "content_style", "subjects", "activities", "objects", "setting", "presentation", "temporal_context", "spoken_language", "dialogue_themes", "speech_summary", "music", "sound_effects", "vocal_delivery", "semantic_summary", "meaning", "intent", "humor_type", "educational_purpose", "cultural_references", "content_focus", "audience_focus", "extraction_confidence", "category_ambiguity", "unsupported_fields", "unverified_fields", "field_evidence"],
  "$defs": {
    "text": {"type": ["string", "null"], "minLength": 1, "maxLength": 700},
    "list": {"type": "array", "maxItems": 12, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 150}}
  },
  "properties": {
    "primary_category": {"type": "string"},
    "subcategory": {"$ref": "#/$defs/text"},
    "secondary_categories": {"$ref": "#/$defs/list"},
    "topics": {"$ref": "#/$defs/list"},
    "tags": {"$ref": "#/$defs/list"},
    "video_format": {"type": "string"},
    "content_style": {"type": "string"},
    "subjects": {"$ref": "#/$defs/list"},
    "activities": {"$ref": "#/$defs/list"},
    "objects": {"$ref": "#/$defs/list"},
    "setting": {"$ref": "#/$defs/text"},
    "presentation": {"$ref": "#/$defs/text"},
    "temporal_context": {"$ref": "#/$defs/text"},
    "spoken_language": {"$ref": "#/$defs/text"},
    "dialogue_themes": {"$ref": "#/$defs/list"},
    "speech_summary": {"$ref": "#/$defs/text"},
    "music": {"$ref": "#/$defs/text"},
    "sound_effects": {"$ref": "#/$defs/list"},
    "vocal_delivery": {"$ref": "#/$defs/text"},
    "semantic_summary": {"type": "string", "minLength": 20, "maxLength": 1000},
    "meaning": {"$ref": "#/$defs/text"},
    "intent": {"$ref": "#/$defs/text"},
    "humor_type": {"$ref": "#/$defs/text"},
    "educational_purpose": {"$ref": "#/$defs/text"},
    "cultural_references": {"$ref": "#/$defs/list"},
    "content_focus": {"$ref": "#/$defs/text"},
    "audience_focus": {"$ref": "#/$defs/text"},
    "extraction_confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "category_ambiguity": {"type": "boolean"},
    "unsupported_fields": {"type": "array", "maxItems": 40, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 150}},
    "unverified_fields": {"type": "array", "maxItems": 40, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 150}},
    "field_evidence": {
      "type": "array", "maxItems": 120,
      "items": {"type": "object", "additionalProperties": false,
        "required": ["field", "source", "quote"],
        "properties": {"field": {"type": "string"}, "source": {"enum": ["visual", "audio", "speech_text", "motion_temporal", "transcript", "caption", "title", "original_category", "recorded_language", "acoustic_features"]}, "quote": {"type": "string", "minLength": 1, "maxLength": 250}}}
    }
  }
}
